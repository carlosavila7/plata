FROM node:22-alpine

WORKDIR /app

COPY package.json ./
RUN npm install

# Copy everything so vite.config.ts, tsconfig, etc. are present.
# Source dirs (src/, public/, index.html) are overridden by bind mounts at runtime.
COPY . .
RUN node generateIcons.mjs

EXPOSE 5173

CMD ["npx", "vite", "--host"]
