DATABASE_URL=file:./prisma/dev.db
PORT=3000
PWA_ORIGIN=http://localhost:5173

# Host directory bind-mounted to the API container's /data for the SQLite database
# (docker-compose). Defaults to ./data (relative to the compose file) if unset.
SQLITE_DATA_DIR=./data

# Auth — use a long random value in production (e.g. `openssl rand -hex 32`)
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Temporarily block new account creation while keeping login/refresh/logout
# fully working. Set to "true" to disable signups; unset or "false" (default)
# keeps registration open.
DISABLE_REGISTRATION=false
